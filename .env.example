# This declares an environment variable named DISCORD_TOKEN with the
# given value. "load()" reads the .env file and parses the
# key-value pairs into the environment.
#
# Environment variables are newline-separated, and there must be no
# spaces around the equals sign (").
DISCORD_TOKEN=put your token here
APPLICATION_ID=it's the same as client token
# PostgreSQL connection string (docker compose default:
# postgres://postgres:postgres@localhost:5432/tugbot)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tugbot
# Discord user ID to bypass the mention cooldown (default: 0 = disabled)
ADMIN_USER_ID=your_admin_user_id_here
# Comma-separated Discord user IDs to bypass the mention cooldown
COOLDOWN_EXEMPT_USER_IDS=your_user_id_here
# Comma-separated Discord user IDs that get the slow (longer) cooldown
SLOW_USER_IDS=
# Where the pi skills directory lives (see parseSkillsDir in config.go)
TUGBOT_SKILLS_DIR=
# Log level (info / debug / warn / error)
RUST_LOG=debug
